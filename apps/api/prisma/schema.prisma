generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  projects      Project[]
  palettes      Palette[]
  conversionJobs ConversionJob[]

  @@map("users")
}

model Project {
  id             String    @id @default(uuid())
  userId         String
  name           String
  sourceImageRef String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patterns Pattern[]

  @@index([userId])
  @@map("projects")
}

enum PatternType {
  cross_stitch
  color_by_number
  diamond
}

model Pattern {
  id        String      @id @default(uuid())
  projectId String
  name      String
  type      PatternType
  width     Int
  height    Int
  /// PaletteEntry[] (see @stitchcraft/types) - stored as JSON, validated at the DTO layer
  palette   Json
  /// EncodedRow[] run-length-encoded grid rows (see @stitchcraft/types)
  grid      Json
  /// PatternMeta (fabricCount, drillSizeMm, createdFrom, ...)
  meta      Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("patterns")
}

enum PaletteKind {
  custom
}

model Palette {
  id        String      @id @default(uuid())
  ownerId   String
  kind      PaletteKind @default(custom)
  name      String
  /// PaletteEntry[] with CustomColor entries (see @stitchcraft/types)
  entries   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("palettes")
}

enum ConversionJobStatus {
  queued
  processing
  completed
  failed
}

model ConversionJob {
  id             String              @id @default(uuid())
  userId         String
  status         ConversionJobStatus @default(queued)
  progress       Int                 @default(0)
  /// ConversionParams (see @stitchcraft/types)
  params         Json
  resultPatternId String?
  error          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("conversion_jobs")
}
