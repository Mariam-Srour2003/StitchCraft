{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/api",
    // Cross-package imports (@stitchcraft/types, @stitchcraft/color resolve
    // to sibling packages' src/) pull files outside apps/api into this
    // compilation, so tsc's rootDir inference lands on the repo root
    // regardless; pinning it here just makes that explicit. Note this alone
    // doesn't make the build runnable - plain tsc leaves those path-mapped
    // imports as unresolved bare specifiers, which Node then resolves via
    // the pnpm workspace symlink straight to their .ts source. nest-cli.json
    // enables webpack mode instead, which bundles the real import graph.
    "rootDir": "../..",
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "exclude": ["**/*.spec.ts", "test", "jest.config.ts"],
  "include": ["src/**/*.ts", "prisma/seed.ts"]
}
