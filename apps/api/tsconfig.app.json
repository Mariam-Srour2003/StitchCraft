{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // nest-cli's webpack mode (see nest-cli.json) writes its bundle to
    // apps/api/dist/main.js regardless of this outDir - it does not follow
    // it. outDir still needs to point there anyway: nest start --watch's
    // launcher (unlike one-shot `nest build`) computes where to require()
    // the compiled entry from THIS value, so if it disagreed with webpack's
    // real output location, watch mode would crash looking for a file that
    // was never written.
    "outDir": "./dist",
    // Cross-package imports (@stitchcraft/types, @stitchcraft/color resolve
    // to sibling packages' src/) pull files outside apps/api into this
    // compilation, so tsc's rootDir inference would otherwise land on the
    // repo root; harmless either way since webpack bundles rather than
    // mirrors, but pinned for deterministic ts-loader behavior.
    "rootDir": "../..",
    "emitDecoratorMetadata": true,
    "types": ["node"]
  },
  "exclude": ["**/*.spec.ts", "test", "jest.config.ts"],
  "include": ["src/**/*.ts", "prisma/seed.ts"]
}
