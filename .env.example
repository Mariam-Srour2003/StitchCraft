# Copy to .env and adjust for local development.
# docker-compose.yml sets these directly for the containerized services;
# this file is for running apps/api with `pnpm dev:api` on the host instead.

# --- Database (apps/api) ---
DATABASE_URL=postgresql://stitchcraft:stitchcraft@localhost:5432/stitchcraft

# --- Redis / job queue (apps/api, used starting M2) ---
REDIS_URL=redis://localhost:6379

# --- Auth (apps/api) ---
# Generate real secrets for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# --- CORS (apps/api) ---
WEB_ORIGIN=http://localhost:4200

# --- Server (apps/api) ---
PORT=3000

# --- Local storage adapter (apps/api) ---
STORAGE_LOCAL_DIR=./apps/api/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/storage

# --- Optional AI microservice (apps/api, used starting M5; safe to leave unset) ---
AI_SERVICE_URL=
