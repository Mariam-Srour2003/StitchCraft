{
  "name": "stitchcraft",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "dev:web": "nx run web:serve",
    "dev:api": "nx run api:serve",
    "prisma:generate": "nx run api:prisma-generate",
    "prisma:migrate": "nx run api:prisma-migrate",
    "prepare": "husky"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "nx": "19.8.4",
    "@nx/eslint": "19.8.4",
    "@nx/eslint-plugin": "19.8.4",
    "@nx/jest": "19.8.4",
    "@nx/js": "19.8.4",
    "@nx/workspace": "19.8.4",
    "typescript": "~5.5.0",
    "prettier": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/node": "^20.14.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write"
    ],
    "*.{js,jsx,json,scss,md}": [
      "prettier --write"
    ]
  }
}
